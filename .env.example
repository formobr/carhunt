# carhunt settings. Copy to .env (git-ignored) and fill in values after "=" (no quotes):
#   cp .env.example .env

# --- Telegram (required for alerts) -------------------------------------------
# Bot token from @BotFather. Send /start to your bot once, then put your chat id here
# (or a channel/group id where the bot is a member).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web journal (optional) ----------------------------------------------------
# deploy/publish-web.sh copies the journal page over ssh after every poll.
# Empty CARHUNT_WEB_SSH = the page is only rendered locally to data/web/index.html.
CARHUNT_WEB_SSH=
CARHUNT_WEB_DIR=

# --- Overrides of config.yaml (optional) ----------------------------------------
# Any key in config.yaml can be overridden as CARHUNT__<SECTION>__<KEY>=<value>
# (the value is parsed as YAML: numbers, true/false, [lists]). Uncomment to use:
# CARHUNT__SEARCH__SOURCE_CITY=pittsburgh
# CARHUNT__SEARCH__MAX_PRICE=7000
# CARHUNT__SEARCH__MIN_PRICE=2000
# CARHUNT__SEARCH__PRICE_BANDS=5
# CARHUNT__SEARCH__REGION=Pittsburgh, PA
# CARHUNT__POLL__INTERVAL_MIN=15
# CARHUNT__POLL__MAX_DETAILS_PER_RUN=30
# CARHUNT__POLL__DETAIL_DELAY_S=[2, 5]
# CARHUNT__NOTIFY__MIN_RELIABILITY=0
# CARHUNT__NOTIFY__MIN_VALUE=0
# CARHUNT__NOTIFY__MIN_SUM=120
# CARHUNT__NOTIFY__PRICE_DROP_MIN_USD=200
# CARHUNT__NOTIFY__PRICE_DROP_MIN_PCT=5
# CARHUNT__AI__TRIAGE_MODEL=haiku
# CARHUNT__AI__JUDGE_MODEL=opus
# CARHUNT__AI__MAX_PHOTOS=20
# CARHUNT__AI__TIMEOUT_S=240
# CARHUNT__HEALTH__FAIL_RUNS_BEFORE_ALERT=2
# CARHUNT__REPORT__TIMEZONE=America/New_York
